{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "node": true,
    "mocha": true
  },
  "rules": {
    "no-console": "off"
  },
  "ignorePatterns": ["dist/", "node_modules/", "vscode/"]
}
