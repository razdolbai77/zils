; Doc comments in asMSX mode
;
; Hover over the six call sites at the bottom of this file.

; End-of-line doc comments

inline_label: nop ;! Label documented by an end-of-line comment.

INLINE_VALUE equ 42 ;! Equate documented by an end-of-line comment.

inline_macro: macro ;! Macro documented by an end-of-line comment.
endm

; Preceding multi-line doc comments

;! Label documented by comments before its definition.
;! Consecutive doc comment lines form one multi-line description.
preceding_label:
    ret

;! Equate documented by comments before its definition.
;! Its description can span multiple lines too.
PRECEDING_VALUE equ 7

;! Macro documented by comments before its definition.
;! Hover shows every consecutive doc comment line.
preceding_macro: macro
endm

; Call sites

    jp inline_label
    ld a,INLINE_VALUE
    inline_macro
    jp preceding_label
    ld a,PRECEDING_VALUE
    preceding_macro
