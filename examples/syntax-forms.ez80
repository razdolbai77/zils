; Valid eZ80 numeric, string, expression, label, comment, macro, and conditional forms

numeric_decimal db 123
numeric_dollar db $1a
numeric_hex_prefix db 0x1a
numeric_hex_suffix db 1ah
numeric_binary_prefix db %1010
numeric_binary_suffix db 1010b
numeric_agon_hex db #1a
numeric_agon_binary db 0b1010
numeric_octal_prefix db 077
numeric_octal_suffix db 77o
numeric_float db 1.5e2
string_escapes db "line\n\t\"\\\?"
character_escape db '\n'

op_unary_plus equ +5
op_unary_minus equ -5
op_bitwise_not equ ~15
op_logical_not equ !0
op_add equ 1 + 2
op_subtract equ 3 - 1
op_multiply equ 2 * 3
op_divide equ 6 / 2
op_modulo equ 5 % 2
op_bitwise_or equ 1 | 2
op_bitwise_and equ 1 & 3
op_bitwise_xor equ 1 ^ 3
op_shift_left equ 1 << 2
op_shift_right equ 8 >> 1
op_equal equ 1 == 1
op_equal_single equ 1 = 1
op_not_equal equ 1 != 2
op_not_equal_alt equ 1 <> 2
op_less equ 1 < 2
op_greater equ 2 > 1
op_less_equal equ 1 <= 1
op_greater_equal equ 2 >= 2
op_logical_and equ 1 && 1
op_logical_or equ 1 || 0
op_named_and equ 1 AND 3
op_named_or equ 1 OR 2
op_named_xor equ 1 XOR 3
op_named_not equ NOT 0
op_named_mod equ 5 MOD 2
op_named_shl equ 1 SHL 2
op_named_shr equ 4 SHR 1
op_named_eq equ 1 EQ 1
op_named_ne equ 1 NE 2
op_named_lt equ 1 LT 2
op_named_le equ 1 LE 1
op_named_gt equ 2 GT 1
op_named_ge equ 2 GE 2
op_parentheses equ (1 + 2) * 3
op_current_location equ $ + 5

global_label:
@local_label:
@@:
colonless_label nop
assignment_label = 1

; Semicolon comments are supported in eZ80 mode

macro emit_value
    nop
endm

if 1
    nop
else
    nop
endif
