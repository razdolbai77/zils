; example.ez80 - Showcases eZ80/ez80asm specific features and diagnostics

        org     0100h

global_label:
        ld      a,5
        add     a,b
        ret

; ez80asm local label using @
@local_label:
        inc     a
        jp      nz,@local_label

; temporary labels
@@:
        dec     a
        jp      nz,@b
        jp      z,@f

@@:
        ret

; ez80asm specific directives
        assume  adl=1
        dl      123456h
        align   4

; eZ80 instructions and suffixes
        lea     hl,ix+5
        pea     ix+0
        ld.lil  bc,123456h
        ld.s    hl,(123456h)
        ld.l    hl,(123456h)
        ld      l,0
        in0     a,(255)
        slp

; ez80asm indirect addressing (using parenthesis)
        ld      a,(hl)
        ld      (de),a
        ld      b,(ix+4)

; 2) Diagnostics

; asMSX local label using dot in an eZ80 file might yield a diagnostic in strict mode
.asmsx_local_label:
        dec     a

; incorrect indirect addressing (asMSX prefers brackets, ez80asm uses parens)
; this might yield a diagnostic in strict mode
        ld      a,[hl]
        ld      [d],a
        ld      (iy+4),(de)
        ld      (de+4),a
        ld      b,([$1000+4])
        ld      c,[$0F-1]

; incorrect directives
        org     blah
        assume  adl=2
        assume  xyz=0

; asMSX specific directives in an eZ80 file should yield diagnostics
        megas
        bios
        fpos    100
        insert  file.bin
        phase   0200h
        rb      1
        rw      1
        dephase
