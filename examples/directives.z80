;; Valid asMSX directives examples

        .ZILOG
        .ORG    0x100
        .PAGE   1
const:  .EQU    42
data_db: .DB     1
data_defb: .DEFB 2
data_dw: .DW     3
data_defw: .DEFW 4
data_ds: .DS     1
data_defs: .DEFS 1
data_rs: .RS     1
emit_bytes: .MACRO #value
        .DB     #value
        .ENDM
        .BIOS
        .BIOSVARS
        .START  0x100
        .ROM
        .MEGAROM konami
        .BASIC
        .MSXDOS
        .SEARCH
        .SUBPAGE 1 AT 0x4000
        .SELECT 1 AT 0x4000
        .PHASE  0x8000
        nop
        .DEPHASE
        .CALLBIOS 0x0010
        .CALLDOS 0x0005
        .SIZE   32
        .INCLUDE "somefile.asm"
        .INCBIN "data.bin"
        .INCBIN "data.bin" skip 10
        .INCBIN "data.bin" size 20
        .INCBIN "data.bin" skip 10 size 20
        .DEBUG  "debug message"
        .BREAK
        .BREAKPOINT
        .BREAK  0x4000
        .REPT   5
        nop
        .ENDR
        .PRINTTEXT "hello"
        .PRINTSTRING "world"
        .PRINT  10+2
        .PRINTDEC 20
        .PRINTHEX 255
        .PRINTFIX 3.14
        .CAS
        .CAS    "name"
        .CASSETTE
        .CASSETTE "name2"
        .WAV
        .WAV    "audio"
        .FILENAME
        .FILENAME "out.rom"
        .SINCLAIR
