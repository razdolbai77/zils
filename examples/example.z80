; example.z80 - Showcases Z80/asMSX specific features and diagnostics

        .ORG    0100h

global_label:
        ld      a,5
        add     a,b
        ret

; asMSX local label usually starts with a dot
.local_label:
        inc     a
        jp      nz,.local_label
@@another_local_label:
        dec     a
        jp      nz,@@another_local_label

; asMSX specific directives
        .MEGAS  KONAMI
        .BIOS
        .FPOS   100
        .INSERT "file.bin"
        .PHASE  0200h
        .RB     1 ; EXPECTED-DIAGNOSTIC 9:2: Directive 'rb' requires a label
        .RW     1 ; EXPECTED-DIAGNOSTIC 9:2: Directive 'rw' requires a label
        .ROM
        .DEPHASE

; asMSX indirect addressing (using brackets)
        ld      a,[hl]
        ld      [de],a

; 2) Diagnostics

; ez80asm local label using @ in a Z80 file should yield a diagnostic
@ez80_local_label: ; EXPECTED-DIAGNOSTIC 0:17: Local label starting with a single '@' is an ez80asm feature, but file is asMSX (.z80)
        dec     a

; incorrect indirect addressing (eZ80asm uses parens, asMSX prefers brackets)
; this might yield a diagnostic in strict mode
        ld      a,(hl) ; EXPECTED-DIAGNOSTIC 18:4: Parentheses around a register indicate indirect addressing; use square brackets instead
        ld      (de),a ; EXPECTED-DIAGNOSTIC 16:4: Parentheses around a register indicate indirect addressing; use square brackets instead

; eZ80 instructions in a Z80 file should yield diagnostics
        lea     hl,ix+5 ; EXPECTED-DIAGNOSTIC 8:3: Instruction 'lea' is not supported in dialect z80
        pea     ix+0 ; EXPECTED-DIAGNOSTIC 8:3: Instruction 'pea' is not supported in dialect z80
    ld.lil bc, 123456h ; EXPECTED-DIAGNOSTIC 7:3: Invalid suffix 'lil' for dialect z80
    ld.s hl, (123456h) ; EXPECTED-DIAGNOSTIC 7:1: Invalid suffix 's' for dialect z80
        in0     a,(255) ; EXPECTED-DIAGNOSTIC 8:3: Instruction 'in0' is not supported in dialect z80
        slp ; EXPECTED-DIAGNOSTIC 8:3: Instruction 'slp' is not supported in dialect z80

; ez80asm specific directives in a Z80 file should yield diagnostics
        assume  adl=1 ; EXPECTED-DIAGNOSTIC 8:6: Unknown instruction: assume
        dl      123456h ; EXPECTED-DIAGNOSTIC 8:2: Unknown instruction: dl
        align   4 ; EXPECTED-DIAGNOSTIC 8:5: Unknown instruction: align
