; Valid eZ80 directives examples

constant EQU    42
        DB      1
        DEFB    2
        ASCII   "hello"
        ASCIZ   "world"
        BYTE    3
        DW      4
        DEFW    5
        DL      6
        DW24    7
        DW32    8
        DS      1
        DEFS    1
        BLKB    9
        BLKB    10,11
        BLKW    12
        BLKW    13,14
        BLKP    15
        BLKP    16,17
        BLKL    18
        BLKL    19,20
        .INCBIN "data.bin"
        .INCLUDE "included.ez80"
        .MACLIB "macros.ez80"
MACRO emit_bytes arg1,arg2
        ld      a,arg1
        ld      a,arg2
@@:
        jr      @b
@macro_local:
        jr      @macro_local
        nop
ENDMACRO

.IF blah
        nop
.ELSE
        nop
.ENDIF

        emit_bytes 1,2
