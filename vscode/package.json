{
  "name": "zaets",
  "displayName": "Zaets",
  "description": "Z80 and eZ80 assembly language support, powered by zils",
  "version": "6.1.13",
  "publisher": "razdolbai",
  "icon": "images/icon.jpg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/razdolbai/zils.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:z80",
    "onLanguage:ez80"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zaets.help",
        "title": "Zaets: Help"
      },
      {
        "command": "zaets.signaturesHelp",
        "title": "Zaets: Signatures' Help"
      }
    ],
    "configurationDefaults": {
      "[z80]": {
        "editor.detectIndentation": false,
        "editor.indentSize": 8,
        "editor.tabSize": 8
      },
      "[ez80]": {
        "editor.detectIndentation": false,
        "editor.indentSize": 8,
        "editor.tabSize": 8
      }
    },
    "languages": [
      {
        "id": "z80",
        "aliases": [
          "asMSX Z80 assembly",
          "z80"
        ],
        "extensions": [
          ".z80"
        ],
        "configuration": "./language-configuration.json",
        "semanticHighlighting": true
      },
      {
        "id": "ez80",
        "aliases": [
          "Agon-ez80asm eZ80 assembly",
          "ez80"
        ],
        "extensions": [
          ".ez80"
        ],
        "configuration": "./language-configuration.json",
        "semanticHighlighting": true
      }
    ],
    "configuration": {
      "title": "Zaets",
      "properties": {
        "zaets.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/**/*.test.js"
  },
  "dependencies": {
    "@razdolbai/zils": "^6.1.12",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/proxyquire": "^1.3.31",
    "@types/vscode": "^1.80.0",
    "proxyquire": "^2.1.3",
    "typescript": "^5.0.0"
  }
}
