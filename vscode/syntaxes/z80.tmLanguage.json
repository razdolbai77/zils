{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Z80 Assembly",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#directives" },
    { "include": "#labels" },
    { "include": "#instructions" },
    { "include": "#numbers" },
    { "include": "#registers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.character.z80",
          "match": ";.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.z80"
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.z80"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i)\\b(equ|db|defb|dw|defw|ds|defs|org|include|macro|endm|megas|bios|fpos|rb|rw|rl|rs|insert|phase|dephase)\\b",
          "name": "support.function.directive.z80"
        },
        {
          "match": "(?i)^\\s*\\.[a-z0-9_]+\\b",
          "name": "support.function.directive.z80"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "^[A-Za-z_@\\.][A-Za-z0-9_@]*:?",
          "name": "entity.name.function.z80"
        },
        {
          "match": ":[A-Za-z_@\\.][A-Za-z0-9_]*",
          "name": "entity.name.function.z80"
        }
      ]
    },
    "instructions": {
      "patterns": [
        {
          "match": "(?i)\\b(adc|add|and|bit|call|ccf|cp|cpd|cpdr|cpi|cpir|cpl|daa|dec|di|djnz|ei|ex|exx|halt|im|in|inc|ind|indr|ini|inir|jp|jr|ld|ldd|lddr|ldi|ldir|neg|nop|or|otdr|otir|out|outd|outi|pop|push|res|ret|reti|retn|rl|rla|rlc|rlca|rld|rr|rra|rrc|rrca|rrd|rst|sbc|scf|set|sla|sra|srl|sub|xor)\\b",
          "name": "keyword.control.z80"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "match": "(?i)\\b(a|b|c|d|e|h|l|af|bc|de|hl|sp|ix|iy|i|r|ixh|ixl|iyh|iyl|z|nz|nc|po|pe|p|m)\\b",
          "name": "variable.language.register.z80"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\$[0-9A-Fa-f]+",
          "name": "constant.numeric.hex.z80"
        },
        {
          "match": "0x[0-9A-Fa-f]+",
          "name": "constant.numeric.hex.z80"
        },
        {
          "match": "\\b[0-9][0-9A-Fa-f]*[hH]\\b",
          "name": "constant.numeric.hex.z80"
        },
        {
          "match": "%[01]+",
          "name": "constant.numeric.binary.z80"
        },
        {
          "match": "\\b[01]+[bB]\\b",
          "name": "constant.numeric.binary.z80"
        },
        {
          "match": "\\b[0-9]+\\b",
          "name": "constant.numeric.decimal.z80"
        }
      ]
    }
  },
  "scopeName": "source.z80"
}
