{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "eZ80 Assembly",
  "patterns": [
    {
      "include": "#comments"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.character.ez80",
          "match": ";.*$"
        }
      ]
    }
  },
  "scopeName": "source.ez80"
}
